# ============================================================
# ZEN PANGKAS RAMBUT — Contoh Environment Variables
# Salin file ini menjadi .env (lokal), atau isi di
# Vercel → Settings → Environment Variables.
#
# PENTING untuk VERCEL: tempel HANYA nilainya — TANPA tanda kutip
# dan TANPA awalan "NAMA_VAR=". Tanda kutip hanya berlaku di .env lokal.
# ============================================================

# ===== 1. Database (WAJIB) =====
# Connection string dari project Neon Anda (Console → Connect).
# DATABASE_URL        → POOLED (host mengandung "-pooler", port 6543)
# DIRECT_DATABASE_URL → DIRECT (port 5432) — dipakai untuk prisma db push / migrate
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# ===== 2. Keamanan sesi login (WAJIB) =====
# Kunci rahasia JWT. Buat acak, misal: openssl rand -hex 48
AUTH_SECRET=""

# ===== 3. Development lokal (opsional) =====
# Jalankan `bun run dev:db` untuk memulai Postgres portabel,
# lalu `bunx prisma db push`. Nilai di bawah adalah default dev script.
# DATABASE_URL="postgresql://postgres@localhost:5433/postgres"
# DIRECT_DATABASE_URL="postgresql://postgres@localhost:5433/postgres"
